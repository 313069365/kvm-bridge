# 本机专用的远程部署/测试脚本与 SSH 凭据一律不公开
/.remote/
.DS_Store

# 开发期原型脚本（含本机绝对路径、内网地址），仅本机保留
/mac/capability.py
/mac/kvm_server.py
/scripts/probe-roundtrip.sh
/scripts/probe-switch.sh
